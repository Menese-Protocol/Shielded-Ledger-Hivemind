    },
    "scale_fixture_b": {
      "type": "motoko",
      "main": "tests/ScaleFixture.mo"
    },
    "scale_fixture_c": {
      "type": "motoko",
      "main": "tests/ScaleFixture.mo"
    },
    "icrc3_archive_fixture": {
      "type": "motoko",
      "main": "tests/Icrc3ArchiveFixture.mo"
    },
    "hash_parity_fixture": {
      "type": "motoko",
      "main": "tests/HashParityFixture.mo"
    },
    "hash_parity_fixture_b": {
      "type": "motoko",
      "main": "tests/HashParityFixture.mo"
    },
    "window_fixture": {
      "type": "motoko",
      "main": "tests/WindowFixture.mo"
