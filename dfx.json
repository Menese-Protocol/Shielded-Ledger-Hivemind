    },
    "honest_tree_oracle": {
      "type": "motoko",
      "main": "tests/HonestTreeOracle.mo"
    },
    "coordinator": {
      "main": "coordinator/src/Main.mo",
      "type": "motoko"
    },
    "ceremony_client": {
      "type": "assets",
      "source": ["demo-frontend/contributor-client"]
    }
